# --- Signing material: never in the repo (lives in GitHub encrypted secrets or on the owner's machine) ---
*.p12
*.pfx
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
.env
.env.*

# --- Build output ---
build/
DerivedData/
*.ipa
*.xcarchive
Payload/

# --- Generated Xcode project: project.yml is the source of truth ---
*.xcodeproj
*.xcworkspace
xcuserdata/

# --- OS and tool clutter ---
.DS_Store
Thumbs.db
.remember/
.claude/settings.local.json

# --- Generated by XcodeGen from project.yml ---
App/Info.plist
